generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER_ADMIN

  @@map("user_role")
}

enum SensitiveDocumentType {
  CPF
  CNPJ

  @@map("sensitive_document_type")
}

enum CommercialEntityType {
  INDIVIDUAL
  LEGAL_ENTITY

  @@map("commercial_entity_type")
}

enum EmploymentState {
  ACTIVE
  TERMINATED

  @@map("employment_state")
}

enum MachineType {
  YELLOW_LINE
  WHITE_LINE

  @@map("machine_type")
}

enum MachineIdentifierKind {
  PLATE
  COMPANY_TAG

  @@map("machine_identifier_kind")
}

enum MachineMeterReadingPurpose {
  INITIAL
  OWNERSHIP_TRANSFER
  ORDINARY

  @@map("machine_meter_reading_purpose")
}

enum MachineMeterReadingStatus {
  CONFIRMED

  @@map("machine_meter_reading_status")
}

model Corporation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains   Domain[]
  companies Company[]
  users     User[]
  sessions  Session[]
  sensitiveDocumentHarnessRows SensitiveDocumentProtectionHarness[]
  clients   Client[]
  fuelSuppliers FuelSupplier[]
  persons   Person[]
  employments Employment[]
  machines Machine[]
  machineOwnershipPeriods MachineOwnershipPeriod[]
  machineIdentifiers MachineIdentifier[]
  machineMeterReadings MachineMeterReading[]
  machineMeterReadingCorrections MachineMeterReadingCorrection[]
  machineMeterReadingReferences MachineMeterReadingReference[]

  @@map("corporations")
}

model Domain {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  host          String      @unique @db.VarChar(253)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)

  @@index([corporationId])
  @@map("domains")
}

model Company {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  name          String      @db.VarChar(160)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  sessions      Session[]
  sensitiveDocumentHarnessRows SensitiveDocumentProtectionHarness[]
  clients       Client[]
  fuelSuppliers FuelSupplier[]
  employments   Employment[]
  machineOwnershipPeriods MachineOwnershipPeriod[]
  machineIdentifiers MachineIdentifier[]
  machineMeterReadings MachineMeterReading[]
  machineMeterReadingCorrections MachineMeterReadingCorrection[]
  machineMeterReadingReferences MachineMeterReadingReference[]

  @@unique([corporationId, id])
  @@unique([corporationId, name])
  @@map("companies")
}

model User {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  email         String      @db.VarChar(254)
  passwordHash  String      @map("password_hash")
  role          UserRole    @default(MASTER_ADMIN)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  sessions      Session[]
  removedClients Client[] @relation("ClientRemovedBy")
  removedFuelSuppliers FuelSupplier[] @relation("FuelSupplierRemovedBy")
  machineMeterReadings MachineMeterReading[] @relation("MachineMeterReadingActor")
  machineMeterReadingCorrections MachineMeterReadingCorrection[] @relation("MachineMeterReadingCorrectionActor")

  @@unique([corporationId, id])
  @@unique([corporationId, email])
  @@map("users")
}

model Session {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId            String      @map("corporation_id") @db.Uuid
  userId                   String      @map("user_id") @db.Uuid
  companyId                String?     @map("company_id") @db.Uuid
  refreshTokenHash         String?     @map("refresh_token_hash")
  consumedRefreshTokenHash String?     @map("consumed_refresh_token_hash")
  refreshVersion           Int         @default(0) @map("refresh_version")
  refreshConsumedAt        DateTime?   @map("refresh_consumed_at") @db.Timestamptz(3)
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt               DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt            DateTime    @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt        DateTime    @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revocationReason         String?     @map("revocation_reason") @db.VarChar(120)
  corporation              Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  user                     User        @relation(fields: [corporationId, userId], references: [corporationId, id], onDelete: Restrict)
  company                  Company?    @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, userId])
  @@index([corporationId, companyId])
  @@map("sessions")
}

model SensitiveDocumentProtectionHarness {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  registryType         String                @map("registry_type") @db.VarChar(64)
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, registryType])
  @@index([documentDigest])
  @@map("sensitive_document_protection_harness")
}

model Client {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                 @map("corporation_id") @db.Uuid
  companyId            String                 @map("company_id") @db.Uuid
  entityType           CommercialEntityType   @map("entity_type")
  documentType         SensitiveDocumentType  @map("document_type")
  ciphertext           String                 @db.Text
  iv                   String                 @db.VarChar(64)
  authTag              String                 @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                 @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                 @map("document_digest") @db.VarChar(96)
  displayName          String                 @map("display_name") @db.VarChar(180)
  fullName             String?                @map("full_name") @db.VarChar(180)
  legalName            String?                @map("legal_name") @db.VarChar(180)
  tradeName            String?                @map("trade_name") @db.VarChar(180)
  phone                String?                @db.VarChar(32)
  email                String?                @db.VarChar(254)
  addressLine          String?                @map("address_line") @db.VarChar(220)
  city                 String?                @db.VarChar(120)
  state                String?                @db.VarChar(80)
  postalCode           String?                @map("postal_code") @db.VarChar(24)
  isActive             Boolean                @default(true) @map("is_active")
  inactivatedAt        DateTime?              @map("inactivated_at") @db.Timestamptz(3)
  removedAt            DateTime?              @map("removed_at") @db.Timestamptz(3)
  removedByUserId      String?                @map("removed_by_user_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation            @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company                @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  removedBy            User?                  @relation("ClientRemovedBy", fields: [corporationId, removedByUserId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, displayName, id])
  @@index([documentDigest])
  @@index([removedAt], map: "clients_removed_at_idx")
  @@map("clients")
}

model FuelSupplier {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                 @map("corporation_id") @db.Uuid
  companyId            String                 @map("company_id") @db.Uuid
  entityType           CommercialEntityType   @map("entity_type")
  documentType         SensitiveDocumentType  @map("document_type")
  ciphertext           String                 @db.Text
  iv                   String                 @db.VarChar(64)
  authTag              String                 @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                 @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                 @map("document_digest") @db.VarChar(96)
  displayName          String                 @map("display_name") @db.VarChar(180)
  fullName             String?                @map("full_name") @db.VarChar(180)
  legalName            String?                @map("legal_name") @db.VarChar(180)
  tradeName            String?                @map("trade_name") @db.VarChar(180)
  phone                String?                @db.VarChar(32)
  email                String?                @db.VarChar(254)
  addressLine          String?                @map("address_line") @db.VarChar(220)
  city                 String?                @db.VarChar(120)
  state                String?                @db.VarChar(80)
  postalCode           String?                @map("postal_code") @db.VarChar(24)
  isActive             Boolean                @default(true) @map("is_active")
  inactivatedAt        DateTime?              @map("inactivated_at") @db.Timestamptz(3)
  removedAt            DateTime?              @map("removed_at") @db.Timestamptz(3)
  removedByUserId      String?                @map("removed_by_user_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation            @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company                @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  removedBy            User?                  @relation("FuelSupplierRemovedBy", fields: [corporationId, removedByUserId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, displayName, id])
  @@index([documentDigest])
  @@index([removedAt], map: "fuel_suppliers_removed_at_idx")
  @@map("fuel_suppliers")
}

model FuelType {
  id        String   @id @db.VarChar(32)
  name      String   @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fuel_types")
}

model Person {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  displayName          String                @map("display_name") @db.VarChar(180)
  fullName             String                @map("full_name") @db.VarChar(180)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  employments          Employment[]

  @@unique([corporationId, id])
  @@unique([corporationId, documentDigest])
  @@index([corporationId, displayName, id])
  @@index([documentDigest])
  @@map("persons")
}

model Employment {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId             String             @map("corporation_id") @db.Uuid
  companyId                 String             @map("company_id") @db.Uuid
  personId                  String             @map("person_id") @db.Uuid
  companyRegistrationNumber String             @map("company_registration_number") @db.VarChar(80)
  state                     EmploymentState    @default(ACTIVE)
  isActive                  Boolean            @default(true) @map("is_active")
  terminatedAt              DateTime?          @map("terminated_at") @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation               Corporation        @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company                   Company            @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  person                    Person             @relation(fields: [corporationId, personId], references: [corporationId, id], onDelete: Restrict)
  periods                   EmploymentPeriod[]

  @@unique([corporationId, companyId, id])
  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, companyRegistrationNumber], map: "employments_corporation_id_company_id_company_registration_numb")
  @@index([corporationId, personId])
  @@map("employments")
}

model EmploymentPeriod {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId     String      @map("corporation_id") @db.Uuid
  companyId         String      @map("company_id") @db.Uuid
  employmentId      String      @map("employment_id") @db.Uuid
  admissionDate     DateTime    @map("admission_date") @db.Date
  effectiveFrom     DateTime    @map("effective_from") @db.Date
  effectiveTo       DateTime?   @map("effective_to") @db.Date
  terminationReason String?     @map("termination_reason") @db.VarChar(240)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  employment        Employment  @relation(fields: [corporationId, companyId, employmentId], references: [corporationId, companyId, id], onDelete: Restrict)

  @@index([corporationId, companyId, employmentId])
  @@index([corporationId, companyId, effectiveFrom, id], map: "employment_periods_corporation_id_company_id_effective_from_id_")
  @@map("employment_periods")
}

model Machine {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  name          String      @db.VarChar(160)
  description   String?     @db.VarChar(500)
  type          MachineType
  manufacturer  String      @db.VarChar(120)
  model         String      @db.VarChar(120)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  ownershipPeriods MachineOwnershipPeriod[]
  identifiers   MachineIdentifier[]
  meterReadings MachineMeterReading[]

  @@unique([corporationId, id])
  @@index([corporationId, createdAt, id])
  @@index([corporationId, name, id])
  @@map("machines")
}

model MachineOwnershipPeriod {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  machineId     String      @map("machine_id") @db.Uuid
  effectiveFrom DateTime    @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime?   @map("effective_to") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company       Company     @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  machine       Machine     @relation(fields: [corporationId, machineId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, machineId])
  @@index([corporationId, companyId, effectiveFrom, id])
  @@map("machine_ownership_periods")
}

model MachineIdentifier {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId   String                @map("corporation_id") @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  machineId       String                @map("machine_id") @db.Uuid
  kind            MachineIdentifierKind
  value           String                @db.VarChar(80)
  normalizedValue String                @map("normalized_value") @db.VarChar(80)
  releasedAt      DateTime?             @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation     Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company         Company               @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  machine         Machine               @relation(fields: [corporationId, machineId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, machineId])
  @@index([corporationId, companyId, kind, normalizedValue])
  @@map("machine_identifiers")
}

model MachineMeterReading {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String                    @map("corporation_id") @db.Uuid
  companyId     String                    @map("company_id") @db.Uuid
  machineId     String                    @map("machine_id") @db.Uuid
  readingSequence Int                     @map("reading_sequence")
  value         Decimal                   @db.Decimal(14, 2)
  status        MachineMeterReadingStatus @default(CONFIRMED)
  purpose       MachineMeterReadingPurpose
  actorUserId   String                    @map("actor_user_id") @db.Uuid
  recordedAt    DateTime                  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation               @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company       Company                   @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  machine       Machine                   @relation(fields: [corporationId, machineId], references: [corporationId, id], onDelete: Restrict)
  actor         User                      @relation("MachineMeterReadingActor", fields: [corporationId, actorUserId], references: [corporationId, id], onDelete: Restrict)
  corrections   MachineMeterReadingCorrection[]
  references    MachineMeterReadingReference[]

  @@unique([corporationId, companyId, machineId, id])
  @@unique([corporationId, machineId, readingSequence], map: "machine_meter_readings_corporation_id_machine_id_sequence_key")
  @@index([corporationId, companyId, machineId, readingSequence])
  @@map("machine_meter_readings")
}

model MachineMeterReadingCorrection {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String              @map("corporation_id") @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  machineId     String              @map("machine_id") @db.Uuid
  readingId     String              @map("reading_id") @db.Uuid
  actorUserId   String              @map("actor_user_id") @db.Uuid
  oldValue      Decimal             @map("old_value") @db.Decimal(14, 2)
  newValue      Decimal             @map("new_value") @db.Decimal(14, 2)
  reason        String              @db.VarChar(500)
  correctedAt   DateTime            @default(now()) @map("corrected_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  corporation   Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company       Company             @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict, map: "mmr_corrections_company_fkey")
  reading       MachineMeterReading @relation(fields: [corporationId, companyId, machineId, readingId], references: [corporationId, companyId, machineId, id], onDelete: Restrict, map: "mmr_corrections_reading_fkey")
  actor         User                @relation("MachineMeterReadingCorrectionActor", fields: [corporationId, actorUserId], references: [corporationId, id], onDelete: Restrict, map: "machine_meter_reading_corrections_corporation_id_actor_user_id_")

  @@index([corporationId, companyId, machineId, readingId])
  @@map("machine_meter_reading_corrections")
}

model MachineMeterReadingReference {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String              @map("corporation_id") @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  machineId     String              @map("machine_id") @db.Uuid
  readingId     String              @map("reading_id") @db.Uuid
  sourceType    String              @map("source_type") @db.VarChar(80)
  sourceId      String              @map("source_id") @db.VarChar(120)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  corporation   Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company       Company             @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict, map: "mmr_references_company_fkey")
  reading       MachineMeterReading @relation(fields: [corporationId, companyId, machineId, readingId], references: [corporationId, companyId, machineId, id], onDelete: Restrict, map: "mmr_references_reading_fkey")

  @@unique([corporationId, companyId, readingId, sourceType, sourceId])
  @@index([corporationId, companyId, machineId, readingId])
  @@map("machine_meter_reading_references")
}
