              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "code", "message", "requestId"],
                  "properties": {
                    "success": { "type": "boolean", "enum": [false] },
                    "code": { "type": "string" },
                    "message": { "type": "string" },
                    "details": { "type": "object", "nullable": true },
                    "requestId": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "code", "message", "requestId"],
                  "properties": {
                    "success": { "type": "boolean", "enum": [false] },
                    "code": { "type": "string" },
