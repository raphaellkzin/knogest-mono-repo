{
  "name": "main-api",
  "version": "1.0.0",
  "description": "Fastify + TypeScript + Prisma backend template.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "./scripts/run-integration-tests.sh",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:personal-data-gate": "tsx scripts/validate-personal-data-gate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:fixtures": "NODE_ENV=development tsx prisma/seeds/development-fixtures.ts",
    "admin": "tsx scripts/admin-cli.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/check-openapi-drift.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
